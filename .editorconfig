root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# shfmt reads these keys; source-format checks them.
[*.{sh,bash}]
indent_size = 2
shell_variant = bash
switch_case_indent = true

[Makefile]
indent_style = tab

